msgstr "{count} casillas: toca para elegir"

#. The tiles are being picked: each tile tapped on the world is picked or unpicked.
msgctxt "ui.worldBuilderQuest.picking"
msgid "Tap the world, then here"
msgstr "Toca el mundo y luego aquí"

#. The heading of the quest's tasks.
msgctxt "ui.worldBuilderQuest.tasks"
msgid "Tasks"
msgstr "Tareas"

#. The heading of a task, e.g. "Task 2".
msgctxt "ui.worldBuilderQuest.task"
msgid "Task {number}"
msgstr "Tarea {number}"

#. The label of whether a task is to defeat, to talk or to visit.
msgctxt "ui.worldBuilderQuest.kind"
msgid "Kind"
msgstr "Clase"

#. A task to defeat units.
msgctxt "ui.worldBuilderQuest.defeat"
msgid "Defeat"
msgstr "Derrotar"

#. A task to talk to an npc.
msgctxt "ui.worldBuilderQuest.talk"
msgid "Talk"
msgstr "Hablar"

#. A task to reach some tiles.
msgctxt "ui.worldBuilderQuest.visit"
msgid "Visit"
msgstr "Visitar"

#. The label of the unit a task asks to defeat.
msgctxt "ui.worldBuilderQuest.unit"
msgid "Unit"
msgstr "Unidad"

#. The label of how many of the unit a task asks to defeat.
msgctxt "ui.worldBuilderQuest.defeats"
msgid "Defeats"
msgstr "Derrotas"

#. The label of the npc a task asks to talk to.
msgctxt "ui.worldBuilderQuest.npc"
msgid "Npc"
msgstr "Personaje"

#. The label of the tiles a task asks to reach.
msgctxt "ui.worldBuilderQuest.visitTiles"
msgid "Tiles"
msgstr "Casillas"

#. The label of what the quest tracker says of the task.
msgctxt "ui.worldBuilderQuest.taskText"
msgid "Text"
msgstr "Texto"

#. The label of what the npc says when the task is done.
msgctxt "ui.worldBuilderQuest.taskLine"
msgid "Line"
msgstr "Frase"

#. Takes the task away from the quest.
msgctxt "ui.worldBuilderQuest.removeTask"
msgid "Remove task {number}"
msgstr "Quitar la tarea {number}"

#. Adds a task at the end of the quest.
msgctxt "ui.worldBuilderQuest.addTask"
msgid "Add a task"
msgstr "Añadir una tarea"

#. The heading of what the quest gives when completed.
msgctxt "ui.worldBuilderQuest.reward"
msgid "Reward"
msgstr "Recompensa"

#. The label of the gold the quest gives.
msgctxt "ui.worldBuilderQuest.gold"
msgid "Gold"
msgstr "Oro"

#. The heading of what the quest giver says.
msgctxt "ui.worldBuilderQuest.lines"
msgid "Lines"
msgstr "Frases"

#. The label of what the quest giver says when giving the quest.
msgctxt "ui.worldBuilderQuest.lineStart"
msgid "Start"
msgstr "Al empezar"

#. The label of what the quest giver says while the quest is under way.
msgctxt "ui.worldBuilderQuest.lineReminder"
msgid "Reminder"
msgstr "Recordatorio"

#. The label of what the quest giver says once the quest is completed.
msgctxt "ui.worldBuilderQuest.lineCompleted"
msgid "Completed"
msgstr "Al completar"

#. The label of what the quest giver says when giving a repeatable quest again.
msgctxt "ui.worldBuilderQuest.lineStartAgain"
msgid "Start again"
msgstr "Al repetir"

#. Takes the quest away from the world.
msgctxt "ui.worldBuilderQuest.remove"
msgid "Remove the quest"
msgstr "Quitar la misión"

#. Displayed when a second main quest is added.
msgctxt "ui.worldBuilder.mainQuestTaken"
msgid "The world already has a main quest"
msgstr "El mundo ya tiene una misión principal"

#. Displayed when Playtest is tapped in a world the game can not play, e.g. "To playtest, add one main quest".
msgctxt "ui.worldBuilder.toPlaytest"
msgid "To playtest, {reason}"
msgstr "Para probarlo, {reason}"

#. Displayed when a world that is not playable yet is exported.
msgctxt "ui.worldBuilder.exportedNotPlayable"
msgid "World exported. To be playable, {reason}"
msgstr "Mundo exportado. Para poder jugarlo, {reason}"

#. Ends "To playtest, ..." or "To be playable, ...".
msgctxt "ui.worldBuilder.reasonBattleUnit"
msgid "place a battle unit of {player}"
msgstr "coloca una unidad de {player}"

#. Ends "To playtest, ..." or "To be playable, ...".
msgctxt "ui.worldBuilder.reasonMainQuest"
msgid "add one main quest"
msgstr "añade una misión principal"

#. Ends "To be playable, ...".
msgctxt "ui.worldBuilder.reasonStartTiles"
msgid "pick the start tiles of the main quest"
msgstr "elige las casillas de inicio de la misión principal"

#. Ends "To playtest, ..." or "To be playable, ...".
msgctxt "ui.worldBuilder.reasonTasks"
msgid "give every quest a task"
msgstr "da una tarea a cada misión"

#. The kind of files the file dialog shows.
msgctxt "ui.worldFilePicker.worlds"
msgid "Worlds"
msgstr "Mundos"

#. Why an ability in cooldown can not be cast. {turns}: the turns left until it can be cast again.
msgctxt "ui.abilityInfo.readyIn"
msgid "Ready in {turns} turn"
msgid_plural "Ready in {turns} turns"
msgstr[0] "Disponible en {turns} turno"
msgstr[1] "Disponible en {turns} turnos"

#. Why an ability can not be cast. {manaCost}: the mana it costs. {mana}: the mana the battle unit has left.
msgctxt "ui.abilityInfo.notEnoughMana"
msgid "Needs {manaCost} mana, has {mana}"
msgstr "Necesita {manaCost} de maná, tiene {mana}"

#. Who an ability is cast on: the caster.
msgctxt "ui.abilityInfo.targeting.caster"
msgid "Yourself"
msgstr "Tú mismo"

#. Who an ability is cast on: an enemy next to the caster.
msgctxt "ui.abilityInfo.targeting.adjacentEnemy"
msgid "One adjacent enemy"
msgstr "Un enemigo adyacente"

#. Who an ability is cast on: every enemy next to the caster.
msgctxt "ui.abilityInfo.targeting.allAdjacentEnemies"
msgid "All adjacent enemies"
msgstr "Todos los enemigos adyacentes"

#. Where an ability is cast: an empty tile next to the caster.
msgctxt "ui.abilityInfo.targeting.vacantTileAdjacentToCaster"
msgid "An empty tile next to you"
msgstr "Una casilla vacía junto a ti"

#. Where an ability is cast: an empty tile next to another battle unit.
msgctxt "ui.abilityInfo.targeting.vacantTileAdjacentToAnotherBattleUnit"
msgid "An empty tile next to another unit"
msgstr "Una casilla vacía junto a otra unidad"

#. {damage}: the health points the target loses.
msgctxt "ui.abilityInfo.effect.damage"
msgid "Deals {damage} damage."
msgstr "Inflige {damage} de daño."

#. {verb}: what the effect does, e.g.: Poisons. {damage}: the health points the target loses at the start of each of its turns. {turns}: how many turns.
msgctxt "ui.abilityInfo.effect.damageOnPlayerTurnStarted"
msgid "{verb}: {damage} damage each turn for {turns} turn."
msgid_plural "{verb}: {damage} damage each turn for {turns} turns."
msgstr[0] "{verb}: {damage} de daño por turno durante {turns} turno."
msgstr[1] "{verb}: {damage} de daño por turno durante {turns} turnos."

#. {heal}: the health points the caster recovers.
msgctxt "ui.abilityInfo.effect.healCaster"
msgid "Heals you {heal} HP."
msgstr "Te cura {heal} PV."

#. {heal}: the health points each ally next to the caster recovers.
msgctxt "ui.abilityInfo.effect.healAdjacentAllies"
msgid "Heals adjacent allies {heal} HP."
msgstr "Cura {heal} PV a los aliados adyacentes."

#. {unit}: the name of the summoned unit, e.g.: Bat. {turns}: the turns it stays. {health}: its health points.
msgctxt "ui.abilityInfo.effect.summon"
msgid "Summons {unit} for {turns} turn ({health} HP)."
msgid_plural "Summons {unit} for {turns} turns ({health} HP)."
msgstr[0] "Invoca {unit} durante {turns} turno ({health} PV)."
msgstr[1] "Invoca {unit} durante {turns} turnos ({health} PV)."

#. The caster moves to the tile the ability is cast on.
msgctxt "ui.abilityInfo.effect.teleport"
msgid "Teleports you there."
msgstr "Te teletransporta allí."

#. When the target is defeated, its allies next to it are poisoned. {damage}: the health points each loses at the start of each of its turns. {turns}: how many turns.
msgctxt "ui.abilityInfo.effect.onDefeatedDamageAdjacentAllies"
msgid "When defeated: poisons its adjacent allies ({damage} damage each turn for {turns} turn)."
msgid_plural "When defeated: poisons its adjacent allies ({damage} damage each turn for {turns} turns)."
msgstr[0] "Al ser derrotado: envenena a sus aliados adyacentes ({damage} de daño por turno durante {turns} turno)."
msgstr[1] "Al ser derrotado: envenena a sus aliados adyacentes ({damage} de daño por turno durante {turns} turnos)."

#. {verb}: what the effect does, e.g.: Poisons. {damage}: the health points each ally next to the target loses at the start of each of its turns. {turns}: how many turns.
msgctxt "ui.abilityInfo.effect.damageAdjacentAllies"
msgid "{verb} its adjacent allies ({damage} damage each turn for {turns} turn)."
msgid_plural "{verb} its adjacent allies ({damage} damage each turn for {turns} turns)."
msgstr[0] "{verb} a sus aliados adyacentes ({damage} de daño por turno durante {turns} turno)."
msgstr[1] "{verb} a sus aliados adyacentes ({damage} de daño por turno durante {turns} turnos)."

#. {verb}: what the effect does, e.g.: Stuns. {turns}: how many of the target's turns it can not move nor cast.
msgctxt "ui.abilityInfo.effect.negateActions"
msgid "{verb} for {turns} turn."
msgid_plural "{verb} for {turns} turns."
msgstr[0] "{verb} durante {turns} turno."
msgstr[1] "{verb} durante {turns} turnos."

#. {verb}: what the effect does, e.g.: Soaks. {share}: the share of the damage the target no longer takes. {effect}: the effect whose damage it takes less of, e.g.: burn. {turns}: how many turns.
msgctxt "ui.abilityInfo.effect.resist"
msgid "{verb}: {share}% less damage from {effect} for {turns} turn."
msgid_plural "{verb}: {share}% less damage from {effect} for {turns} turns."
msgstr[0] "{verb}: {share}% menos de daño por {effect} durante {turns} turno."
msgstr[1] "{verb}: {share}% menos de daño por {effect} durante {turns} turnos."

#. An effect applied only when the target already has another one. {condition}: what the target must be, e.g.: soaked. {effect}: what happens then, e.g.: stuns for 2 turns.
msgctxt "ui.abilityInfo.effect.ifOngoing"
msgid "If {condition}: {effect}"
msgstr "Si está {condition}: {effect}"

#. A stacked effect, as the title of its effect info. {effect}: its name, e.g.: Venom. {stacks}: how many times the battle unit received it.
msgctxt "ui.effectInfo.title"
msgid "{effect} x{stacks}"
msgstr "{effect} x{stacks}"

#. What an ongoing effect does in a battle. {damage}: the health points the battle unit loses at the start of each of its turns.
msgctxt "ui.effectInfo.damageOnPlayerTurnStarted"
msgid "{damage} damage at the start of each turn."
msgstr "{damage} de daño al empezar cada turno."

#. What an ongoing effect does while exploring. {damage}: the health points the battle unit loses each second.
msgctxt "ui.effectInfo.damageEachSecond"
msgid "{damage} damage each second."
msgstr "{damage} de daño cada segundo."

#. What a stun does: the battle unit can not move nor cast in its turns.
msgctxt "ui.effectInfo.negateActions"
msgid "Loses its actions at the start of each turn."
msgstr "Pierde sus acciones al empezar cada turno."

#. What an ongoing resist does. {share}: the share of the damage the battle unit no longer takes. {effect}: the effect whose damage it takes less of, e.g.: burn.
msgctxt "ui.effectInfo.resist"
msgid "{share}% less damage from {effect}."
msgstr "{share}% menos de daño por {effect}."

#. What an equipped effect does while its item is equipped. {amount}: how much maximum health it gives.
msgctxt "ui.effectInfo.increaseMaximumHealth"
msgid "+{amount} maximum health while equipped."
msgstr "+{amount} de salud máxima mientras está equipado."

#. What an equipped effect does while its item is equipped. {amount}: how much maximum mana it gives.
msgctxt "ui.effectInfo.increaseMaximumMana"
msgid "+{amount} maximum mana while equipped."
msgstr "+{amount} de maná máximo mientras está equipado."

#. How long a stack of an effect has left in a battle. {turns}: how many turns.
msgctxt "ui.effectInfo.turnsLeft"
msgid "{turns} turn left"
msgid_plural "{turns} turns left"
msgstr[0] "queda {turns} turno"
msgstr[1] "quedan {turns} turnos"

#. How long a stack of an effect has left while exploring. {seconds}: how many seconds.
msgctxt "ui.effectInfo.secondsLeft"
msgid "{seconds} second left"
msgid_plural "{seconds} seconds left"
msgstr[0] "queda {seconds} segundo"
msgstr[1] "quedan {seconds} segundos"

#. How a stack of an effect that has triggered for the last time reads in a battle: it ends when the battle unit's turn finishes, e.g.: the stun that took its actions this turn.
msgctxt "ui.effectInfo.endsThisTurn"
msgid "Ends this turn"
msgstr "Termina este turno"

#. A caption of the steps a battle unit has left this turn, before its points.
msgctxt "ui.hud.move"
msgid "MOVE"
msgstr "MOVER"

#. A caption of the casts a battle unit has left this turn, before its points.
msgctxt "ui.hud.cast"
msgid "CAST"
msgstr "LANZAR"

#. A caption of the health of a battle unit, before its bar: health points.
msgctxt "ui.hud.health"
msgid "HP"
msgstr "PV"

#. A caption of the mana of a battle unit, before its bar: mana points.
msgctxt "ui.hud.mana"
msgid "MP"
msgstr "PM"

#. A battle unit the previewed cast would defeat: knocked out.
msgctxt "ui.castPreview.defeated"
msgid "KO"
msgstr "KO"

#. Who casts the previewed ability. {unit}: the name of the caster.
msgctxt "ui.castPreview.by"
msgid "by {unit}"
msgstr "de {unit}"

#. The mana the previewed cast spends. {mana}: the mana it costs.
msgctxt "ui.castPreview.mana"
msgid "-{mana} mana"
msgstr "-{mana} de maná"

#. On the tracker of the main quest, once it is completed.
msgctxt "ui.questTracker.completed"
msgid "Quest completed"
msgstr "Misión completada"

#. On the tracker while a side quest is active, none is pinned and the main quest has not started. Tapping it opens the journal.
msgctxt "ui.questTracker.empty"
msgid "No quest pinned"
msgstr "Ninguna misión fijada"

#. Over the name of the quest, in its detail.
msgctxt "ui.questDetail.mainQuest"
msgid "MAIN QUEST"
msgstr "MISIÓN PRINCIPAL"

#. Over the name of the quest, in its detail, once it is completed.
msgctxt "ui.questDetail.completed"
msgid "QUEST COMPLETED"
msgstr "MISIÓN COMPLETADA"

#. Before what the quest pays, in its detail.
msgctxt "ui.questDetail.reward"
msgid "REWARD"
msgstr "RECOMPENSA"

#. How many tasks of the quest are done, in its detail. {tasks}: how many.
msgctxt "ui.questDetail.tasksDone"
msgid "{tasks} task done"
msgid_plural "{tasks} tasks done"
msgstr[0] "{tasks} tarea hecha"
msgstr[1] "{tasks} tareas hechas"

#. Closes the detail of the quest, displaying the pad again.
msgctxt "ui.questDetail.back"
msgid "Back"
msgstr "Volver"

#. Over the name of a side quest, in its detail and on its row of the journal.
msgctxt "ui.questDetail.sideQuest"
msgid "SIDE QUEST"
msgstr "MISIÓN SECUNDARIA"

#. On a side quest that can run again, in its detail and on its row of the journal.
msgctxt "ui.quest.repeatable"
msgid "Repeatable"
msgstr "Repetible"

#. Gives a side quest up, in its detail and in the question that asks first.
msgctxt "ui.quest.abandon"
msgid "Abandon"
msgstr "Abandonar"

#. Asked before abandoning a side quest. {quest}: its name.
msgctxt "ui.quest.abandonQuestion"
msgid "Abandon {quest}? Its progress is lost, and its quest giver can start it again."
msgstr "¿Abandonar {quest}? Se pierde su progreso, y quien la encargó puede empezarla de nuevo."

#. The title of the list of every quest started.
msgctxt "ui.questJournal.title"
msgid "Journal"
msgstr "Diario"

#. How many quests are active, beside the title of the journal. {quests}: how many.
msgctxt "ui.questJournal.active"
msgid "{quests} active"
msgid_plural "{quests} active"
msgstr[0] "{quests} activa"
msgstr[1] "{quests} activas"

#. Over the name of a completed quest, on its row of the journal.
msgctxt "ui.questJournal.completed"
msgid "COMPLETED"
msgstr "COMPLETADA"

#. Over the name of the quest, on the announcement announcing that it starts.
msgctxt "ui.questAnnouncement.started"
msgid "NEW QUEST"
msgstr "NUEVA MISIÓN"

#. Over the name of the quest, on the announcement announcing that it is completed.
msgctxt "ui.questAnnouncement.completed"
msgid "QUEST COMPLETED"
msgstr "MISIÓN COMPLETADA"

# Game data: the names of resources/ability/<id>.toml, lootableItem, npc, player, terrain and unit, and the own lines of the npcs.

